{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.alicelabs-llc/marketnow",
  "description": "MCP marketplace with 9,248 security-audited skills (Sentinel L1.5/L1.7 sync scans, L2.5 gVisor sandbox). Fail-closed ATC/1.0 trust verification. Runs over stdio from npm or Docker (ghcr.io/alicelabs-llc/marketnow-mcp).",
  "repository": {
    "url": "https://github.com/alicelabs-llc/MARKETNOW",
    "source": "github"
  },
  "version": "1.15.0",
  "homepage": "https://marketnow.site",
  "license": "MIT",
  "author": {
    "name": "AliceLabs LLC",
    "email": "info@alicelabs.site"
  },
  "categories": [
    "developer-tools",
    "security",
    "ai-agents"
  ],
  "tags": [
    "mcp",
    "marketplace",
    "security",
    "sentinel",
    "gvisor"
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "marketnow-mcp",
      "version": "1.15.0",
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "docker",
      "identifier": "ghcr.io/alicelabs-llc/marketnow-mcp",
      "version": "1.15.0",
      "transport": {
        "type": "stdio"
      },
      "run_command": "docker run -i --rm ghcr.io/alicelabs-llc/marketnow-mcp:1.15.0"
    }
  ]
}
